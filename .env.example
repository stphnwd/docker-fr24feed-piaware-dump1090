# Copy to `.env` and fill in real values. `.env` is gitignored.
# Compose auto-loads `.env` from this directory on `docker compose up`.

# Sharing keys / UUIDs / feeder IDs (secrets)
FR24FEED_FR24KEY=YOUR_FR24_SHARING_KEY
PIAWARE_FEEDER_DASH_ID=YOUR_PIAWARE_FEEDER_ID
ADSBEXCHANGE_UUID=YOUR_ADSBEXCHANGE_UUID
PLANEFINDER_SHARECODE=YOUR_PLANEFINDER_SHARECODE
AIRPLANES_LIVE_UUID=YOUR_AIRPLANES_LIVE_UUID

# Site identity / location
SITE_LAT=0.0
SITE_LON=0.0
SITE_ALT=0
STATION_NAME=My Station

# Receiver IDs used in HTML_RECEIVER_STATS_PAGE_* URLs
FR24_RECEIVER_ID=YOUR_FR24_RECEIVER_ID
ADSBEXCHANGE_RECEIVER_ID=YOUR_ADSBEXCHANGE_RECEIVER_ID
PLANEFINDER_RECEIVER_ID=YOUR_PLANEFINDER_RECEIVER_ID
